<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- paper-coloured from the first frame, so the start never flashes white -->
    <style name="Paper" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">#8C6A3F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#E3D5B8</color>
</resources>
